# Vercel environment variables for /api/audit-request, /api/self-audit, and /api/newsletter.
# Use either RESEND_API_KEY or SENDGRID_API_KEY for email. Resend is tried first.

AUDIT_REQUEST_TO=zajen@n8ivpromotions.com
AUDIT_REQUEST_FROM=N8iV Promotions <no-reply@n8ivpromotions.com>

RESEND_API_KEY=
SENDGRID_API_KEY=

# Cloudflare Turnstile secret. Required: every form submission is rejected without it.
TURNSTILE_SECRET_KEY=

# Newsletter (/api/newsletter) adds signups as Resend contacts.
# The Contacts API needs a full-access key. Set this only if RESEND_API_KEY is sending-only.
RESEND_CONTACTS_API_KEY=
# Optional: Resend segment ID that newsletter signups are added to (for Broadcasts).
RESEND_NEWSLETTER_SEGMENT_ID=
